# 复制为 .env 后按需修改
TZ=Asia/Shanghai

# 宿主机数据目录（相对路径基于 docker-compose.yml 所在目录）
DATA_DIR=./data

# 面板对外端口
ADMIN_PORT=8080
# 网页聊天仅映射到 127.0.0.1，通过 SSH 隧道访问
WEBCHAT_PORT=3002

# NapCat WebUI 登录令牌（必填，改成你自己的随机串）
NAPCAT_WEBUI_TOKEN=change-me-to-a-random-string

# 如使用自建/加速镜像，可覆盖
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
